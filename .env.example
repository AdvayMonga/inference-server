# Copy to .env and edit. Every knob is read by src/inference_server/config.py unless noted.
# Values shown are the defaults.

# ---- Server ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ---- Model + backend ------------------------------------------------------------------
MODEL_NAME=google/gemma-4-E2B-it   # dev model; google/gemma-4-E4B-it is the headline model
DEVICE=auto                        # auto | cuda | mps | cpu   (auto detects CUDA -> MPS -> CPU)
BACKEND=                           # empty = HF Transformers on DEVICE. custom-cuda | custom-mps |
                                   # custom-cpu = the hand-written Gemma 4 forward + paged KV + kernels
MAX_TOKENS=512
CONTEXT_WINDOW=8192

# ---- Batching + scheduling ------------------------------------------------------------
MAX_BATCH_SIZE=32                  # rows decoding at once; 256 on an A100-80GB
BATCH_TIMEOUT_MS=50.0
MAX_QUEUE_SIZE=1000                # pending queue cap -> HTTP 429 above it
MAX_QUEUE_WAIT_S=30.0              # admission deadline; requests older than this are shed (0 = never)
MAX_ACTIVE_KV_TOKENS=0             # cap on (prompt + max_tokens) summed over in-flight rows; 0 = unbounded
SCHEDULING_POLICY=fcfs             # fcfs | fair  (fair = per-session virtual-token-counter share)
WAVE_WINDOW_MULT=0                 # length-grouped prefill waves; 0 = off (measured inert)

# ---- Prefill --------------------------------------------------------------------------
PREFILL_MODE=                      # monolithic | chunked | batched ; empty derives from chunk size
PREFILL_CHUNK_SIZE=0               # chunked prefill chunk (tokens); 0 = monolithic. 256 is a good start

# ---- Cross-session prefix cache (custom backend) --------------------------------------
PREFIX_CACHE_IMPL=radix            # radix (shares at every block boundary) | dict (whole-prompt only)
PREFIX_CACHE_MAX_ENTRIES=1024
PREFIX_CACHE_BLOCK_FRACTION=0.5    # share of the block pool the cache may hold

# ---- KV cache (HF backend: CacheManager + eviction policies) --------------------------
KV_CACHE_MEMORY_FRACTION=0.9
KV_CACHE_BLOCK_SIZE=16
KV_CACHE_NUM_BLOCKS=256
EVICTION_POLICY=lru                # lru | attention_sink_lru | h2o

# ---- Custom backend knobs (read directly by backends/custom_torch_backend.py) ---------
CUSTOM_BACKEND_BLOCKS=512          # paged KV blocks per full-attention layer pool
CUSTOM_BACKEND_SLIDING_BLOCKS=     # blocks per sliding-window layer pool; default = CUSTOM_BACKEND_BLOCKS
CUSTOM_BACKEND_BLOCK_SIZE=16       # tokens per block
CUSTOM_BACKEND_CUDA_GRAPH=1        # bucketed CUDA-graph decode (CUDA only)
CUSTOM_BACKEND_GRAPH_BUCKETS=      # override the decode bucket ladder, e.g. 1,4,16,64,256
CUSTOM_BACKEND_COMPILE=0           # torch.compile the decode forward (CUDA only; ~minutes of startup)
CUSTOM_BACKEND_COMPILE_MODE=       # empty = default fusion | max-autotune-no-cudagraphs
CUSTOM_BACKEND_PREFILL_GRAPH=0     # CUDA-graph the K=1 prefill (bucketed by suffix length)
CUSTOM_BACKEND_QUANT=              # int8 = weight-only int8 Linear layers
CUSTOM_BACKEND_TILED_PREFILL=0     # FlashAttention-style tiled prefill kernel (measured: no e2e win)
CUSTOM_BACKEND_EXPLAIN=0           # print torch.compile graph-break report at startup

# ---- Streaming ------------------------------------------------------------------------
STREAM_BY_DEFAULT=false

# ---- HF backend only ------------------------------------------------------------------
KEEP_MODEL_WARM=true
COMPILE_MODEL=false

# ---- Observability --------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text                    # text | json (structured lines for a log aggregator)
METRICS_PORT=9090                  # Prometheus is also served in-process at /metrics

# ---- Research loop (set by scripts/run_instrument.sh; only needed when emitting panels) --
# RESEARCH_ENGINE_SHA=             # engine commit the panel is attributed to
# RESEARCH_ENGINE_DIRTY=0          # 1 if measured from a dirty tree (the panel is flagged)
# RESEARCH_RUN_GROUP=              # arms of one experiment must share this

# ---- Reserved for the platform layer (read, not yet enforced) -------------------------
MAX_CONCURRENT_SESSIONS=1
PER_SESSION_MEMORY_LIMIT_MB=0
