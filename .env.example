# Copy to .env. Defaults shown; config.py and the backends hold the full list.

MODEL_NAME=Qwen/Qwen3-30B-A3B
BACKEND=                           # empty = custom-<device>; custom-cuda | custom-mps | custom-cpu
PORT=8000

# Batching and scheduling
MAX_BATCH_SIZE=1024
MAX_QUEUE_SIZE=1000                # HTTP 429 above this
MAX_QUEUE_WAIT_S=30.0              # shed requests queued longer than this; 0 = never
SCHEDULING_POLICY=fair             # fair | fcfs
PREFILL_MODE=                      # empty = mixed on custom-*; monolithic | chunked | batched | mixed
ASYNC_DECODE=1
ENGINE_PROCESS=1                   # backend and scheduler in a child process

# Kernels and precision (CUDA)
CUSTOM_BACKEND_QUANT=fp8           # fp8 | bf16 (experts)
KV_CACHE_DTYPE=bf16                # bf16 | fp8
CUSTOM_BACKEND_CUDA_GRAPH=1
MEGAKERNEL=1                       # decode megakernel at small batch

# Observability
LOG_LEVEL=INFO
TELEMETRY_DIR=                     # per-request SQLite rows; empty = off
TIMELINE_DIR=                      # scheduler event timeline (JSONL); empty = off
